<Window x:Class="AccountServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cupcake Account Server" Height="900" Width="1500" MinHeight="700" MinWidth="1100"
        Background="{StaticResource BrushBgDeep}" WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource BrushBgBase}"
            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="20,28,20,30">
          <StackPanel Orientation="Horizontal">
            <Border Width="36" Height="36" CornerRadius="10">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#58A6FF" Offset="0"/>
                  <GradientStop Color="#BC8CFF" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <TextBlock Text="C" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="C U P C A K E" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
              <TextBlock Text="Account Server" FontSize="10" Foreground="{StaticResource BrushTextMuted}" Margin="0,-1,0,0"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Margin="12,0,12,16" Padding="14,12" CornerRadius="10"
                Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="1">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="{StaticResource BrushAccentGreen}" Margin="0,0,8,0"/>
              <TextBlock Text="Server Online" Foreground="{StaticResource BrushAccentGreen}" FontSize="12"
                         FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock x:Name="UptimeLabel" Text="Uptime: 0d 0h 0m 0s" Foreground="{StaticResource BrushTextMuted}"
                       FontSize="10" Margin="16,4,0,0"/>
          </StackPanel>
        </Border>
        <StackPanel Margin="0,0,0,10">
          <TextBlock Text="N A V I G A T I O N" FontSize="10" FontWeight="Bold"
                     Foreground="{StaticResource BrushTextMuted}" Margin="24,0,0,8"/>
          <RadioButton Checked="Nav_Checked" x:Name="NavDashboard" Content="⬡  Dashboard"
                       Style="{StaticResource NavButton}" IsChecked="True" Tag="Dashboard"/>
          <RadioButton Checked="Nav_Checked" Content="⚇  Players" Style="{StaticResource NavButton}" Tag="Players"/>
          <RadioButton Checked="Nav_Checked" Content="⊕  Account Lookup" Style="{StaticResource NavButton}" Tag="Lookup"/>
          <RadioButton Checked="Nav_Checked" Content="⛨  Security" Style="{StaticResource NavButton}" Tag="Security"/>
          <RadioButton Checked="Nav_Checked" Content="☰  Logs" Style="{StaticResource NavButton}" Tag="Logs"/>
          <RadioButton Checked="Nav_Checked" Content="✎  Audit Trail" Style="{StaticResource NavButton}" Tag="Audit"/>
          <TextBlock Text="S Y S T E M" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}"
                     Margin="24,20,0,8"/>
          <RadioButton Checked="Nav_Checked" Content="⚙  Settings" Style="{StaticResource NavButton}" Tag="Settings"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Column="1">
      <Grid x:Name="PanelDashboard" Margin="32,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
          <TextBlock Text="Dashboard" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
          <TextBlock Text="Real-time overview of your account server" FontSize="13"
                     Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,24">
          <Border Margin="0,0,12,0" CornerRadius="14" Padding="20,18" Background="{StaticResource BrushBgSurface}"
                  BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Width="36" Height="36" CornerRadius="10">
                  <Border.Background>
                    <SolidColorBrush Color="{StaticResource AccentGreen}" Opacity="0.15"/>
                  </Border.Background>
                  <TextBlock Text="●" Foreground="{StaticResource BrushAccentGreen}" FontSize="14" HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="ONLINE" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
              </StackPanel>
              <TextBlock FontSize="36" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"
                         Text="{Binding PlayerCount}"/>
              <TextBlock Text="active sessions" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
            </StackPanel>
          </Border>
          <Border Margin="6,0" CornerRadius="14" Padding="20,18" Background="{StaticResource BrushBgSurface}"
                  BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Width="36" Height="36" CornerRadius="10">
                  <Border.Background>
                    <SolidColorBrush Color="{StaticResource AccentBlue}" Opacity="0.15"/>
                  </Border.Background>
                  <TextBlock Text="⬡" Foreground="{StaticResource BrushAccentBlue}" FontSize="16" HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="SERVERS" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
              </StackPanel>
              <TextBlock FontSize="36" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"
                         Text="{Binding ServerCount}"/>
              <TextBlock Text="connected" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
            </StackPanel>
          </Border>
          <Border Margin="6,0" CornerRadius="14" Padding="20,18" Background="{StaticResource BrushBgSurface}"
                  BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Width="36" Height="36" CornerRadius="10">
                  <Border.Background>
                    <SolidColorBrush Color="{StaticResource AccentOrange}" Opacity="0.15"/>
                  </Border.Background>
                  <TextBlock Text="⚠" Foreground="{StaticResource BrushAccentOrange}" FontSize="14" HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="FAILED" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
              </StackPanel>
              <TextBlock FontSize="36" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"
                         Text="{Binding FailedLogins}"/>
              <TextBlock Text="login attempts" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
            </StackPanel>
          </Border>
          <Border Margin="12,0,0,0" CornerRadius="14" Padding="20,18" Background="{StaticResource BrushBgSurface}"
                  BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Width="36" Height="36" CornerRadius="10">
                  <Border.Background>
                    <SolidColorBrush Color="{StaticResource AccentRed}" Opacity="0.15"/>
                  </Border.Background>
                  <TextBlock Text="⛨" Foreground="{StaticResource BrushAccentRed}" FontSize="14" HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="BLOCKED" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
              </StackPanel>
              <TextBlock FontSize="36" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"
                         Text="{Binding BruteForceCount}"/>
              <TextBlock Text="brute force IPs" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
            </StackPanel>
          </Border>
        </UniformGrid>
        <Grid Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
          </Grid.ColumnDefinitions>
          <Grid Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="180"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" CornerRadius="14" Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" Margin="0,0,0,16">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,16,20,12">
                  <TextBlock Text="Live Activity" FontSize="15" FontWeight="SemiBold"
                             Foreground="{StaticResource BrushTextPrimary}"/>
                  <Ellipse Width="8" Height="8" Fill="{StaticResource BrushAccentGreen}" Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
                </StackPanel>
                <ListBox x:Name="listBoxLog" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource BrushTextSecondary}" Padding="16,0,16,12"
                         FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding LogMessages}">
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                      <Setter Property="Control.Padding" Value="4,3"/>
                      <Setter Property="Control.Background" Value="Transparent"/>
                      <Setter Property="Control.BorderThickness" Value="0"/>
                      <Setter Property="Control.Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border Padding="{TemplateBinding Control.Padding}" Background="Transparent">
                              <ContentPresenter/>
                            </Border>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                </ListBox>
              </DockPanel>
            </Border>
            <Border Grid.Row="1" CornerRadius="14" Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" Padding="20,16">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Player Count (24h)" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,12"/>
                <ItemsControl ItemsSource="{Binding PlayerSnapshots}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="1,0">
                        <TextBlock FontSize="9" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"
                                   Text="{Binding PlayerCount}"/>
                        <Border MinHeight="4" CornerRadius="3,3,0,0" MinWidth="8" Height="{Binding BarHeight}">
                          <Border.Background>
                            <SolidColorBrush Color="{StaticResource AccentBlue}" Opacity="0.6"/>
                          </Border.Background>
                        </Border>
                        <TextBlock FontSize="8" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"
                                   Text="{Binding Time}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
            </Border>
          </Grid>
          <StackPanel Grid.Column="1">
            <Border CornerRadius="14" Padding="20" Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Quick Actions" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,14"/>
                <Button Click="ResetPlayerBTN_Click" Content="Reset All Online Status"
                        Style="{StaticResource WarningButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                <Button Click="buttonCopy_Click" Content="Copy Logs to Clipboard" Style="{StaticResource ModernButton}"
                        HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                <Button Click="buttonClear_Click" Content="Clear Log Console" Style="{StaticResource ModernButton}"
                        HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                <Button Click="ExportLogs_Click" Content="Export Logs to File" Style="{StaticResource ModernButton}"
                        HorizontalAlignment="Stretch"/>
              </StackPanel>
            </Border>
            <Border CornerRadius="14" Padding="20" Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="Game Servers" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12"/>
                <ItemsControl ItemsSource="{Binding ConnectedServers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8" Background="{StaticResource BrushBgCard}"
                              BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{Binding StateColor}"/>
                          <StackPanel>
                            <TextBlock Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="13"
                                       Text="{Binding Name}"/>
                            <TextBlock Foreground="{StaticResource BrushTextMuted}" FontSize="10">
                              <Run Text="{Binding PlayerCount, Mode=OneWay}"/>
                              <Run Text=" players · "/>
                              <Run Text="{Binding State, Mode=OneWay}"/>
                            </TextBlock>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No game servers connected" Foreground="{StaticResource BrushTextMuted}" FontSize="12"
                           FontStyle="Italic" Visibility="{Binding NoServersVisible}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Grid>
      <Grid x:Name="PanelPlayers" Margin="32,24" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
          <TextBlock Text="Online Players" FontSize="26" FontWeight="Bold"
                     Foreground="{StaticResource BrushTextPrimary}"/>
          <TextBlock Text="Manage active sessions — select multiple for bulk actions" FontSize="13"
                     Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Row="1" Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox TextChanged="PlayerSearch_TextChanged" x:Name="PlayerSearchBox"
                   Style="{StaticResource ModernTextBox}"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
            <Button Click="RefreshPlayers_Click" Content="Refresh" Style="{StaticResource AccentButton}"
                    Margin="0,0,8,0"/>
            <Button Click="BulkKick_Click" x:Name="BulkKickBtn" Style="{StaticResource WarningButton}" Margin="0,0,8,0"
                    Padding="14,10">
              <TextBlock>
                <Run Text="Bulk Kick ("/>
                <Run Text="{Binding SelectedPlayerCount, Mode=OneWay}"/>
                <Run Text=")"/>
              </TextBlock>
            </Button>
            <Button Click="BulkBan_Click" x:Name="BulkBanBtn" Style="{StaticResource DangerButton}" Padding="14,10">
              <TextBlock>
                <Run Text="Bulk Ban ("/>
                <Run Text="{Binding SelectedPlayerCount, Mode=OneWay}"/>
                <Run Text=")"/>
              </TextBlock>
            </Button>
          </StackPanel>
        </Grid>
        <Border Grid.Row="2" CornerRadius="14" Background="{StaticResource BrushBgSurface}"
                BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" Padding="4">
          <DataGrid x:Name="PlayersGrid" Style="{StaticResource ModernDataGrid}"
                    ItemsSource="{Binding FilteredPlayers}">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="40">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="ID" Width="70" Binding="{Binding Id}"/>
              <DataGridTextColumn Header="CHARACTER" Width="*" Binding="{Binding CharacterName}"/>
              <DataGridTemplateColumn Header="VIP" Width="90">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left"
                            Visibility="{Binding IsVip, Converter={StaticResource BoolToVisibility}}">
                      <Border.Background>
                        <SolidColorBrush Color="{StaticResource AccentPurple}" Opacity="0.15"/>
                      </Border.Background>
                      <TextBlock Foreground="{StaticResource BrushAccentPurple}" FontSize="11" FontWeight="SemiBold">
                        <Run Text="VIP "/>
                        <Run Text="{Binding VipLevel, Mode=OneWay}"/>
                      </TextBlock>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="TIME LEFT" Width="120" Binding="{Binding TimeRemaining}">
                <DataGridBoundColumn.ElementStyle>
                  <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="TextBlock.Foreground" Value="{StaticResource BrushTextSecondary}"/>
                    <Setter Property="FrameworkElement.VerticalAlignment" Value="Center"/>
                  </Style>
                </DataGridBoundColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTemplateColumn Header="ACTIONS" Width="280">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="Kick" Style="{StaticResource WarningButton}" Padding="12,5" FontSize="11" Margin="0,0,6,0"/>
                      <Button Content="Ban" Style="{StaticResource DangerButton}" Padding="12,5" FontSize="11" Margin="0,0,6,0"/>
                      <Button Content="MAC Ban" Style="{StaticResource DangerButton}" Padding="12,5" FontSize="11"/>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </Grid>
      <Grid x:Name="PanelLookup" Margin="32,24" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
          <TextBlock Text="Account Lookup" FontSize="26" FontWeight="Bold"
                     Foreground="{StaticResource BrushTextPrimary}"/>
          <TextBlock Text="Search any account by name, ID, IP, or MAC address" FontSize="13"
                     Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Row="1" Margin="0,0,0,20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox KeyDown="LookupSearch_KeyDown" x:Name="LookupSearchBox" Style="{StaticResource ModernTextBox}"/>
          <Button Click="LookupSearch_Click" Grid.Column="1" Content="Search" Style="{StaticResource AccentButton}"
                  Margin="12,0,0,0"/>
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding LookupVisible}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <Border CornerRadius="14" Padding="24,20" Margin="0,0,0,16" Background="{StaticResource BrushBgSurface}"
                      BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="Account Profile" FontSize="16" FontWeight="SemiBold"
                             Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,16"/>
                  <UniformGrid Columns="2" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,0,12">
                      <TextBlock Text="ID" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                      <TextBlock Foreground="{StaticResource BrushTextPrimary}" FontSize="15" FontWeight="SemiBold"
                                 Text="{Binding LookupProfile.Id}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                      <TextBlock Text="USERNAME" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                      <TextBlock Foreground="{StaticResource BrushTextPrimary}" FontSize="15" FontWeight="SemiBold"
                                 Text="{Binding LookupProfile.Username}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                      <TextBlock Text="STATUS" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                      <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding LookupProfile.Status}"
                                 Foreground="{Binding LookupProfile.StatusColor}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                      <TextBlock Text="TYPE" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                      <TextBlock Foreground="{StaticResource BrushTextPrimary}" FontSize="15"
                                 Text="{Binding LookupProfile.AccountType}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                      <TextBlock Text="MAC ADDRESS" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                      <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="13" FontFamily="Consolas"
                                 Text="{Binding LookupProfile.MacAddress}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                      <TextBlock Text="LAST IP" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                      <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="13" FontFamily="Consolas"
                                 Text="{Binding LookupProfile.LastIP}"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="VIP" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                      <TextBlock Foreground="{StaticResource BrushAccentPurple}" FontSize="15" FontWeight="SemiBold"
                                 Text="{Binding LookupProfile.VipDisplay}"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="ONLINE" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                      <TextBlock Foreground="{StaticResource BrushTextPrimary}" FontSize="15"
                                 Text="{Binding LookupProfile.IsOnline}"/>
                    </StackPanel>
                  </UniformGrid>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Click="LookupKick_Click" Content="Kick" Style="{StaticResource WarningButton}" Padding="14,8"
                            Margin="0,0,8,0"/>
                    <Button Click="LookupBan_Click" Content="Ban" Style="{StaticResource DangerButton}" Padding="14,8"
                            Margin="0,0,8,0"/>
                    <Button Click="LookupUnban_Click" Content="Unban" Style="{StaticResource SuccessButton}" Padding="14,8"
                            Margin="0,0,8,0"/>
                    <Button Click="LookupMacBan_Click" Content="MAC Ban" Style="{StaticResource DangerButton}" Padding="14,8"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border CornerRadius="14" Padding="24,20" Margin="0,0,0,16" Background="{StaticResource BrushBgSurface}"
                      BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="VIP Management" FontSize="16" FontWeight="SemiBold"
                             Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,16"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="VIP Level" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,4"/>
                      <TextBox x:Name="VipLevelBox" Style="{StaticResource ModernTextBox}" Width="80" Text="1"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="Days" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,4"/>
                      <TextBox x:Name="VipDaysBox" Style="{StaticResource ModernTextBox}" Width="80" Text="30"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Button Click="GrantVip_Click" Content="Grant VIP" Style="{StaticResource AccentButton}" Padding="14,8"
                            Margin="0,0,8,0"/>
                    <Button Click="ExtendVip_Click" Content="Extend VIP" Style="{StaticResource SuccessButton}" Padding="14,8"
                            Margin="0,0,8,0"/>
                    <Button Click="RevokeVip_Click" Content="Revoke VIP" Style="{StaticResource DangerButton}" Padding="14,8"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border CornerRadius="14" Padding="16" Background="{StaticResource BrushBgSurface}"
                      BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="Login History (Last 50)" FontSize="15" FontWeight="SemiBold"
                             Foreground="{StaticResource BrushTextPrimary}" Margin="8,4,0,12"/>
                  <DataGrid Style="{StaticResource ModernDataGrid}" MaxHeight="300" ItemsSource="{Binding LoginHistory}">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="DATE" Width="140" Binding="{Binding AttemptedAt}"/>
                      <DataGridTextColumn Header="IP" Width="130" Binding="{Binding IP}"/>
                      <DataGridTemplateColumn Header="RESULT" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Result}"
                                       Foreground="{Binding ResultColor}"/>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="REASON" Width="*" Binding="{Binding Reason}"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </DockPanel>
              </Border>
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="14" Padding="16" Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" VerticalAlignment="Top">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Related Accounts" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextPrimary}" Margin="8,4,0,12"/>
                <DataGrid Style="{StaticResource ModernDataGrid}" MaxHeight="500" ItemsSource="{Binding RelatedAccounts}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Width="60" Binding="{Binding Id}"/>
                    <DataGridTextColumn Header="NAME" Width="*" Binding="{Binding Username}"/>
                    <DataGridTextColumn Header="MATCH" Width="80" Binding="{Binding MatchType}"/>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </Grid>
      <Grid x:Name="PanelSecurity" Margin="32,24" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
          <TextBlock Text="Security Center" FontSize="26" FontWeight="Bold"
                     Foreground="{StaticResource BrushTextPrimary}"/>
          <TextBlock Text="IP bans, MAC bans, and brute force protection" FontSize="13"
                     Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
          <Border Margin="0,0,8,0" CornerRadius="12" Padding="16,14" Background="{StaticResource BrushBgSurface}"
                  BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <Border Width="42" Height="42" CornerRadius="10">
                <Border.Background>
                  <SolidColorBrush Color="{StaticResource AccentRed}" Opacity="0.15"/>
                </Border.Background>
                <TextBlock Text="⛨" Foreground="{StaticResource BrushAccentRed}" FontSize="18" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </Border>
              <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"
                           Text="{Binding BruteForceCount}"/>
                <TextBlock Text="IP Bans" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Margin="4,0" CornerRadius="12" Padding="16,14" Background="{StaticResource BrushBgSurface}"
                  BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <Border Width="42" Height="42" CornerRadius="10">
                <Border.Background>
                  <SolidColorBrush Color="{StaticResource AccentOrange}" Opacity="0.15"/>
                </Border.Background>
                <TextBlock Text="⚠" Foreground="{StaticResource BrushAccentOrange}" FontSize="18" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </Border>
              <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"
                           Text="{Binding MacBanCount}"/>
                <TextBlock Text="MAC Bans" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Margin="8,0,0,0" CornerRadius="12" Padding="16,14" Background="{StaticResource BrushBgSurface}"
                  BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <Border Width="42" Height="42" CornerRadius="10">
                <Border.Background>
                  <SolidColorBrush Color="{StaticResource AccentCyan}" Opacity="0.15"/>
                </Border.Background>
                <TextBlock Text="●" Foreground="{StaticResource BrushAccentCyan}" FontSize="18" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </Border>
              <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"
                           Text="{Binding ActiveBruteForceAttempts}"/>
                <TextBlock Text="Active Tracking" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </UniformGrid>
        <Grid Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" CornerRadius="14" Background="{StaticResource BrushBgSurface}"
                  BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" Margin="0,0,8,0" Padding="16">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Brute Force IP Bans" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="ManualIpBanBox" Style="{StaticResource ModernTextBox}"/>
                  <Button Click="ManualIpBan_Click" Grid.Column="1" Content="Ban IP" Style="{StaticResource DangerButton}"
                          Margin="8,0,0,0" Padding="14,8"/>
                  <Button Click="RefreshBruteForce_Click" Grid.Column="2" Content="Refresh"
                          Style="{StaticResource ModernButton}" Margin="8,0,0,0" Padding="14,8"/>
                </Grid>
              </StackPanel>
              <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding BannedIPs}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="IP ADDRESS" Width="*" Binding="{Binding IP}"/>
                  <DataGridTextColumn Header="EXPIRES" Width="140" Binding="{Binding ExpiresAt}"/>
                  <DataGridTemplateColumn Header="" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Content="Unban" Style="{StaticResource SuccessButton}" Padding="8,4" FontSize="11"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
          <Border Grid.Column="1" CornerRadius="14" Background="{StaticResource BrushBgSurface}"
                  BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" Margin="8,0,0,0" Padding="16">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="MAC Address Bans" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="ManualMacBanBox" Style="{StaticResource ModernTextBox}"/>
                  <Button Click="ManualMacBan_Click" Grid.Column="1" Content="Ban MAC" Style="{StaticResource DangerButton}"
                          Margin="8,0,0,0" Padding="14,8"/>
                  <Button Click="RefreshMacBans_Click" Grid.Column="2" Content="Refresh"
                          Style="{StaticResource ModernButton}" Margin="8,0,0,0" Padding="14,8"/>
                </Grid>
              </StackPanel>
              <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding BannedMACs}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="MAC ADDRESS" Width="*" Binding="{Binding MacAddress}"/>
                  <DataGridTemplateColumn Header="" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Content="Unban" Style="{StaticResource SuccessButton}" Padding="8,4" FontSize="11"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
      <Grid x:Name="PanelLogs" Margin="32,24" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
          <TextBlock Text="Server Logs" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
          <TextBlock Text="Full log output with filtering and export" FontSize="13"
                     Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Row="1" Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <RadioButton Checked="LogFilter_Changed" Content="All" GroupName="LogFilter" IsChecked="True"
                         Style="{StaticResource NavButton}" Margin="0,0,4,0"/>
            <RadioButton Checked="LogFilter_Changed" Content="Auth" GroupName="LogFilter" Style="{StaticResource NavButton}"
                         Margin="0,0,4,0"/>
            <RadioButton Checked="LogFilter_Changed" Content="Session" GroupName="LogFilter"
                         Style="{StaticResource NavButton}" Margin="0,0,4,0"/>
            <RadioButton Checked="LogFilter_Changed" Content="Security" GroupName="LogFilter"
                         Style="{StaticResource NavButton}" Margin="0,0,4,0"/>
            <RadioButton Checked="LogFilter_Changed" Content="System" GroupName="LogFilter"
                         Style="{StaticResource NavButton}" Margin="0,0,4,0"/>
            <RadioButton Checked="LogFilter_Changed" Content="VIP" GroupName="LogFilter" Style="{StaticResource NavButton}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <CheckBox x:Name="AutoScrollToggle" Content="Auto-scroll" Style="{StaticResource ToggleSwitch}"
                      IsChecked="True" Margin="0,0,16,0"/>
            <Button Click="ExportLogs_Click" Content="Export" Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
            <Button Click="buttonCopy_Click" Content="Copy" Style="{StaticResource ModernButton}" Margin="0,0,8,0"/>
            <Button Click="buttonClear_Click" Content="Clear" Style="{StaticResource DangerButton}"/>
          </StackPanel>
        </Grid>
        <Border Grid.Row="2" CornerRadius="14" Background="{StaticResource BrushBgSurface}"
                BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" Padding="4">
          <ListBox x:Name="listBoxLogFull" Background="Transparent" BorderThickness="0"
                   Foreground="{StaticResource BrushTextSecondary}" Padding="12,8"
                   FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12.5"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding FilteredLogs}">
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="{x:Type ListBoxItem}">
                <Setter Property="Control.Padding" Value="6,3"/>
                <Setter Property="Control.Background" Value="Transparent"/>
                <Setter Property="Control.BorderThickness" Value="0"/>
                <Setter Property="Control.Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                      <Border Padding="{TemplateBinding Control.Padding}" Background="Transparent">
                        <ContentPresenter/>
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ItemsControl.ItemContainerStyle>
          </ListBox>
        </Border>
      </Grid>
      <Grid x:Name="PanelAudit" Margin="32,24" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
          <TextBlock Text="Audit Trail" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
          <TextBlock Text="Every admin action is permanently logged" FontSize="13"
                     Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Row="1" Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <RadioButton Checked="AuditFilter_Changed" Content="All" GroupName="AuditFilter" IsChecked="True"
                         Style="{StaticResource NavButton}" Margin="0,0,4,0"/>
            <RadioButton Checked="AuditFilter_Changed" Content="Kick" GroupName="AuditFilter"
                         Style="{StaticResource NavButton}" Margin="0,0,4,0"/>
            <RadioButton Checked="AuditFilter_Changed" Content="Ban" GroupName="AuditFilter"
                         Style="{StaticResource NavButton}" Margin="0,0,4,0"/>
            <RadioButton Checked="AuditFilter_Changed" Content="VIP" GroupName="AuditFilter"
                         Style="{StaticResource NavButton}" Margin="0,0,4,0"/>
            <RadioButton Checked="AuditFilter_Changed" Content="Unban" GroupName="AuditFilter"
                         Style="{StaticResource NavButton}"/>
          </StackPanel>
          <Button Click="RefreshAudit_Click" Grid.Column="1" Content="Refresh" Style="{StaticResource AccentButton}"/>
        </Grid>
        <Border Grid.Row="2" CornerRadius="14" Background="{StaticResource BrushBgSurface}"
                BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" Padding="4">
          <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding FilteredAuditLogs}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="DATE" Width="150" Binding="{Binding PerformedAt}"/>
              <DataGridTextColumn Header="ACTION" Width="120" Binding="{Binding Action}"/>
              <DataGridTextColumn Header="TARGET ID" Width="90" Binding="{Binding TargetAccountId}"/>
              <DataGridTextColumn Header="TARGET" Width="160" Binding="{Binding TargetInfo}"/>
              <DataGridTextColumn Header="DETAILS" Width="*" Binding="{Binding Details}"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </Grid>
      <Grid x:Name="PanelSettings" Margin="32,24" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
          <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
          <TextBlock Text="Server configuration and preferences" FontSize="13"
                     Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="750" HorizontalAlignment="Left">
            <Border CornerRadius="14" Padding="24,20" Margin="0,0,0,16" Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="Server Mode" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,16"/>
                <DockPanel Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="GM Only Mode" FontSize="14" FontWeight="Medium"
                               Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Only accounts with type &gt; 0 can log in" FontSize="12"
                               Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <CheckBox Checked="GmOnly_Changed" Unchecked="GmOnly_Changed" x:Name="GmOnlyToggle"
                            Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"/>
                </DockPanel>
                <TextBlock FontSize="12" Foreground="{StaticResource BrushTextMuted}">
                  <Run Text="Status: "/>
                  <Run Foreground="{StaticResource BrushAccentBlue}" Text="{Binding GmOnlyStatus, Mode=OneWay}"/>
                </TextBlock>
              </StackPanel>
            </Border>
            <Border CornerRadius="14" Padding="24,20" Margin="0,0,0,16" Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
              <StackPanel>
                <DockPanel Margin="0,0,0,16">
                  <TextBlock Text="Config.ini Editor" FontSize="16" FontWeight="SemiBold"
                             Foreground="{StaticResource BrushTextPrimary}"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Click="ReloadConfig_Click" Content="Reload" Style="{StaticResource ModernButton}" Padding="12,6"
                            FontSize="12" Margin="0,0,8,0"/>
                    <Button Click="SaveConfig_Click" Content="Save Changes" Style="{StaticResource AccentButton}"
                            Padding="12,6" FontSize="12"/>
                  </StackPanel>
                </DockPanel>
                <DataGrid Style="{StaticResource ModernDataGrid}" IsReadOnly="False" RowHeight="38"
                          ItemsSource="{Binding ConfigEntries}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="SECTION" Width="140" IsReadOnly="True" Binding="{Binding Section}"/>
                    <DataGridTextColumn Header="KEY" Width="120" IsReadOnly="True" Binding="{Binding Key}"/>
                    <DataGridTextColumn Header="VALUE" Width="*" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                      <DataGridBoundColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                          <Setter Property="TextBlock.Foreground" Value="{StaticResource BrushAccentBlue}"/>
                          <Setter Property="FrameworkElement.VerticalAlignment" Value="Center"/>
                        </Style>
                      </DataGridBoundColumn.ElementStyle>
                      <DataGridBoundColumn.EditingElementStyle>
                        <Style TargetType="{x:Type TextBox}">
                          <Setter Property="Control.Background" Value="{StaticResource BrushBgCard}"/>
                          <Setter Property="Control.Foreground" Value="{StaticResource BrushTextPrimary}"/>
                          <Setter Property="Control.BorderThickness" Value="0"/>
                          <Setter Property="Control.Padding" Value="4,2"/>
                        </Style>
                      </DataGridBoundColumn.EditingElementStyle>
                    </DataGridTextColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Note: Database changes require a restart to take effect."
                           Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontStyle="Italic" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <Border CornerRadius="14" Padding="24,20" Margin="0,0,0,16" Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="About" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Cupcake Account Server v2.0" Foreground="{StaticResource BrushTextSecondary}" FontSize="13"/>
                <TextBlock Text=".NET 8.0 · WPF · MySQL" Foreground="{StaticResource BrushTextMuted}" FontSize="12"
                           Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>