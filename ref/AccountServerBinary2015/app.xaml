<Application x:Class="AccountServer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <Color x:Key="BgDeep">#080A0F</Color>
    <Color x:Key="BgBase">#0D1117</Color>
    <Color x:Key="BgSurface">#161B22</Color>
    <Color x:Key="BgCard">#1C2128</Color>
    <Color x:Key="BgElevated">#242A33</Color>
    <Color x:Key="BgHover">#2D333B</Color>
    <Color x:Key="BorderSubtle">#2D333B</Color>
    <Color x:Key="BorderDefault">#3D444D</Color>
    <Color x:Key="TextPrimary">#E6EDF3</Color>
    <Color x:Key="TextSecondary">#8B949E</Color>
    <Color x:Key="TextMuted">#545D68</Color>
    <Color x:Key="AccentBlue">#58A6FF</Color>
    <Color x:Key="AccentPurple">#BC8CFF</Color>
    <Color x:Key="AccentGreen">#3FB950</Color>
    <Color x:Key="AccentOrange">#D29922</Color>
    <Color x:Key="AccentRed">#F85149</Color>
    <Color x:Key="AccentCyan">#39D2C0</Color>
    <SolidColorBrush x:Key="BrushBgDeep" Color="{StaticResource BgDeep}"/>
    <SolidColorBrush x:Key="BrushBgBase" Color="{StaticResource BgBase}"/>
    <SolidColorBrush x:Key="BrushBgSurface" Color="{StaticResource BgSurface}"/>
    <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource BgCard}"/>
    <SolidColorBrush x:Key="BrushBgElevated" Color="{StaticResource BgElevated}"/>
    <SolidColorBrush x:Key="BrushBgHover" Color="{StaticResource BgHover}"/>
    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource BorderSubtle}"/>
    <SolidColorBrush x:Key="BrushBorderDefault" Color="{StaticResource BorderDefault}"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource TextMuted}"/>
    <SolidColorBrush x:Key="BrushAccentBlue" Color="{StaticResource AccentBlue}"/>
    <SolidColorBrush x:Key="BrushAccentPurple" Color="{StaticResource AccentPurple}"/>
    <SolidColorBrush x:Key="BrushAccentGreen" Color="{StaticResource AccentGreen}"/>
    <SolidColorBrush x:Key="BrushAccentOrange" Color="{StaticResource AccentOrange}"/>
    <SolidColorBrush x:Key="BrushAccentRed" Color="{StaticResource AccentRed}"/>
    <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource AccentCyan}"/>
    <Style x:Key="ModernButton" TargetType="{x:Type Button}">
      <Setter Property="Control.Background" Value="{StaticResource BrushBgElevated}"/>
      <Setter Property="Control.Foreground" Value="{StaticResource BrushTextPrimary}"/>
      <Setter Property="Control.BorderBrush" Value="{StaticResource BrushBorderSubtle}"/>
      <Setter Property="Control.BorderThickness" Value="1"/>
      <Setter Property="Control.Padding" Value="16,10"/>
      <Setter Property="Control.FontSize" Value="13"/>
      <Setter Property="Control.FontWeight" Value="SemiBold"/>
      <Setter Property="FrameworkElement.Cursor" Value="Hand"/>
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="border" Background="{TemplateBinding Control.Background}"
                    BorderBrush="{TemplateBinding Control.BorderBrush}"
                    BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="8"
                    Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter TargetName="border" Value="{StaticResource BrushBgHover}" Property="Border.Background"/>
                <Setter TargetName="border" Value="{StaticResource BrushBorderDefault}" Property="Border.BorderBrush"/>
              </Trigger>
              <Trigger Property="ButtonBase.IsPressed" Value="True">
                <Setter TargetName="border" Value="{StaticResource BrushBgSurface}" Property="Border.Background"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
      <Setter Property="Control.Background">
        <Setter.Value>
          <SolidColorBrush Color="{StaticResource AccentBlue}"/>
        </Setter.Value>
      </Setter>
      <Setter Property="Control.Foreground" Value="#FFFFFF"/>
      <Setter Property="Control.BorderBrush" Value="Transparent"/>
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="border" CornerRadius="8" Padding="{TemplateBinding Control.Padding}"
                    SnapsToDevicePixels="True">
              <Border.Background>
                <SolidColorBrush Color="{StaticResource AccentBlue}"/>
              </Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter TargetName="border" Property="UIElement.Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="ButtonBase.IsPressed" Value="True">
                <Setter TargetName="border" Property="UIElement.Opacity" Value="0.7"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
      <Setter Property="Control.Background">
        <Setter.Value>
          <SolidColorBrush Color="{StaticResource AccentRed}" Opacity="0.15"/>
        </Setter.Value>
      </Setter>
      <Setter Property="Control.Foreground" Value="{StaticResource BrushAccentRed}"/>
      <Setter Property="Control.BorderBrush">
        <Setter.Value>
          <SolidColorBrush Color="{StaticResource AccentRed}" Opacity="0.3"/>
        </Setter.Value>
      </Setter>
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="border" Background="{TemplateBinding Control.Background}"
                    BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Border.Background">
                  <Setter.Value>
                    <SolidColorBrush Color="{StaticResource AccentRed}" Opacity="0.25"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WarningButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
      <Setter Property="Control.Background">
        <Setter.Value>
          <SolidColorBrush Color="{StaticResource AccentOrange}" Opacity="0.15"/>
        </Setter.Value>
      </Setter>
      <Setter Property="Control.Foreground" Value="{StaticResource BrushAccentOrange}"/>
      <Setter Property="Control.BorderBrush">
        <Setter.Value>
          <SolidColorBrush Color="{StaticResource AccentOrange}" Opacity="0.3"/>
        </Setter.Value>
      </Setter>
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="border" Background="{TemplateBinding Control.Background}"
                    BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Border.Background">
                  <Setter.Value>
                    <SolidColorBrush Color="{StaticResource AccentOrange}" Opacity="0.25"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SuccessButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
      <Setter Property="Control.Background">
        <Setter.Value>
          <SolidColorBrush Color="{StaticResource AccentGreen}" Opacity="0.15"/>
        </Setter.Value>
      </Setter>
      <Setter Property="Control.Foreground" Value="{StaticResource BrushAccentGreen}"/>
      <Setter Property="Control.BorderBrush">
        <Setter.Value>
          <SolidColorBrush Color="{StaticResource AccentGreen}" Opacity="0.3"/>
        </Setter.Value>
      </Setter>
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="border" Background="{TemplateBinding Control.Background}"
                    BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Border.Background">
                  <Setter.Value>
                    <SolidColorBrush Color="{StaticResource AccentGreen}" Opacity="0.25"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavButton" TargetType="{x:Type RadioButton}">
      <Setter Property="Control.Foreground" Value="{StaticResource BrushTextSecondary}"/>
      <Setter Property="Control.FontSize" Value="13"/>
      <Setter Property="Control.FontWeight" Value="Medium"/>
      <Setter Property="FrameworkElement.Cursor" Value="Hand"/>
      <Setter Property="Control.Padding" Value="14,12"/>
      <Setter Property="FrameworkElement.Margin" Value="8,2"/>
      <Setter Property="RadioButton.GroupName" Value="NavGroup"/>
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RadioButton}">
            <Border x:Name="border" Background="Transparent" CornerRadius="8"
                    Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter TargetName="border" Value="{StaticResource BrushBgElevated}" Property="Border.Background"/>
                <Setter Value="{StaticResource BrushTextPrimary}" Property="Control.Foreground"/>
              </Trigger>
              <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="border" Property="Border.Background">
                  <Setter.Value>
                    <SolidColorBrush Color="{StaticResource AccentBlue}" Opacity="0.12"/>
                  </Setter.Value>
                </Setter>
                <Setter Value="{StaticResource BrushAccentBlue}" Property="Control.Foreground"/>
                <Setter Property="Control.FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ModernTextBox" TargetType="{x:Type TextBox}">
      <Setter Property="Control.Background" Value="{StaticResource BrushBgSurface}"/>
      <Setter Property="Control.Foreground" Value="{StaticResource BrushTextPrimary}"/>
      <Setter Property="Control.BorderBrush" Value="{StaticResource BrushBorderSubtle}"/>
      <Setter Property="Control.BorderThickness" Value="1"/>
      <Setter Property="Control.Padding" Value="12,10"/>
      <Setter Property="Control.FontSize" Value="13"/>
      <Setter Property="TextBoxBase.CaretBrush" Value="{StaticResource BrushAccentBlue}"/>
      <Setter Property="TextBoxBase.SelectionBrush" Value="{StaticResource BrushAccentBlue}"/>
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TextBox}">
            <Border x:Name="border" Background="{TemplateBinding Control.Background}"
                    BorderBrush="{TemplateBinding Control.BorderBrush}"
                    BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="8"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="UIElement.IsFocused" Value="True">
                <Setter TargetName="border" Value="{StaticResource BrushAccentBlue}" Property="Border.BorderBrush"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="{x:Type ScrollBar}">
      <Setter Property="FrameworkElement.Width" Value="8"/>
      <Setter Property="Control.Background" Value="Transparent"/>
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid>
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Control.Template>
                      <ControlTemplate>
                        <Border CornerRadius="4" Background="#3D444D" Margin="1" Opacity="0.6"/>
                      </ControlTemplate>
                    </Control.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ModernDataGrid" TargetType="{x:Type DataGrid}">
      <Setter Property="Control.Background" Value="Transparent"/>
      <Setter Property="Control.Foreground" Value="{StaticResource BrushTextPrimary}"/>
      <Setter Property="Control.BorderThickness" Value="0"/>
      <Setter Property="DataGrid.RowBackground" Value="Transparent"/>
      <Setter Property="DataGrid.AlternatingRowBackground" Value="{StaticResource BrushBgSurface}"/>
      <Setter Property="DataGrid.GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="DataGrid.HorizontalGridLinesBrush" Value="{StaticResource BrushBorderSubtle}"/>
      <Setter Property="DataGrid.HeadersVisibility" Value="Column"/>
      <Setter Property="DataGrid.SelectionMode" Value="Single"/>
      <Setter Property="DataGrid.AutoGenerateColumns" Value="False"/>
      <Setter Property="DataGrid.CanUserAddRows" Value="False"/>
      <Setter Property="DataGrid.CanUserDeleteRows" Value="False"/>
      <Setter Property="DataGrid.IsReadOnly" Value="True"/>
      <Setter Property="Control.FontSize" Value="13"/>
      <Setter Property="DataGrid.RowHeight" Value="44"/>
    </Style>
    <Style TargetType="{x:Type DataGridColumnHeader}">
      <Setter Property="Control.Background" Value="Transparent"/>
      <Setter Property="Control.Foreground" Value="{StaticResource BrushTextSecondary}"/>
      <Setter Property="Control.FontSize" Value="11"/>
      <Setter Property="Control.FontWeight" Value="Bold"/>
      <Setter Property="Control.Padding" Value="12,10"/>
      <Setter Property="Control.BorderBrush" Value="{StaticResource BrushBorderSubtle}"/>
      <Setter Property="Control.BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style TargetType="{x:Type DataGridCell}">
      <Setter Property="Control.Padding" Value="12,0"/>
      <Setter Property="Control.BorderThickness" Value="0"/>
      <Setter Property="Control.Foreground" Value="{StaticResource BrushTextPrimary}"/>
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type DataGridCell}">
            <Border Padding="{TemplateBinding Control.Padding}" Background="Transparent">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="DataGridCell.IsSelected" Value="True">
          <Setter Property="Control.Background">
            <Setter.Value>
              <SolidColorBrush Color="{StaticResource AccentBlue}" Opacity="0.1"/>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type DataGridRow}">
      <Setter Property="Control.Background" Value="Transparent"/>
      <Setter Property="Control.BorderThickness" Value="0"/>
      <Style.Triggers>
        <Trigger Property="UIElement.IsMouseOver" Value="True">
          <Setter Property="Control.Background" Value="{StaticResource BrushBgElevated}"/>
        </Trigger>
        <Trigger Property="DataGridRow.IsSelected" Value="True">
          <Setter Property="Control.Background">
            <Setter.Value>
              <SolidColorBrush Color="{StaticResource AccentBlue}" Opacity="0.08"/>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ToggleSwitch" TargetType="{x:Type CheckBox}">
      <Setter Property="Control.Foreground" Value="{StaticResource BrushTextPrimary}"/>
      <Setter Property="FrameworkElement.Cursor" Value="Hand"/>
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type CheckBox}">
            <StackPanel Orientation="Horizontal">
              <Grid Width="44" Height="24">
                <Border x:Name="track" CornerRadius="12" Background="{StaticResource BrushBgElevated}"
                        BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1"/>
                <Border x:Name="thumb" Width="18" Height="18" CornerRadius="9"
                        Background="{StaticResource BrushTextSecondary}" HorizontalAlignment="Left" Margin="3,0,0,0"/>
              </Grid>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="track" Property="Border.Background">
                  <Setter.Value>
                    <SolidColorBrush Color="{StaticResource AccentBlue}"/>
                  </Setter.Value>
                </Setter>
                <Setter TargetName="track" Property="Border.BorderBrush" Value="Transparent"/>
                <Setter TargetName="thumb" Property="FrameworkElement.HorizontalAlignment" Value="Right"/>
                <Setter TargetName="thumb" Property="FrameworkElement.Margin" Value="0,0,3,0"/>
                <Setter TargetName="thumb" Property="Border.Background" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>