{
  "Database": {
    "Hostname": "localhost",
    "Username": "root",
    "Password": "12345678",
    "Schema": "Nyx",
    "Port": 3306,
    "ConnectionPoolMinSize": 32,
    "ConnectionPoolMaxSize": 300,
    "CommandTimeoutSeconds": 30,
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 3
  },
  "Redis": {
    "Hostname": "localhost",
    "Port": 6379,
    "Password": "",
    "Database": 0,
    "ConnectTimeoutMs": 5000,
    "SyncTimeoutMs": 5000,
    "EnableAbortOnConnectFail": false,
    "InstanceName": "nyx:"
  },
  "Server": {
    "ServerAddress": "26.194.141.66",
    "AuthPort": 9960,
    "GamePort": 5816
  },
  "Combat": {
    "UseCombatEngine": false
  },
  "Partitioning": {
    "PartitionCount": 32,
    "EntitiesPerPartition": 200,
    "MaxLoadPercentBeforeRebalance": 80,
    "EnableDynamicRebalancing": true,
    "RebalanceCheckIntervalMs": 30000,
    "HashFunction": "XXHash",
    "SpatialMode": "Grid",
    "GridCellSize": 20
  },
  "Threading": {
    "CombatWorkerCount": 8,
    "PlayerInputWorkerCount": 8,
    "AIWorkerCount": 4,
    "BackgroundWorkerCount": 2,
    "MaxQueueDepth": 10000,
    "EnableWorkStealing": true,
    "PreferPerPartitionScheduling": true
  },
  "HealthChecks": {
    "EnableHealthChecks": true,
    "HealthCheckIntervalSeconds": 30,
    "EnableReadinessProbe": true,
    "EnableLivenessProbe": true
  },
  "Telemetry": {
    "EnableOpenTelemetry": true,
    "ServiceName": "nyx-game-server",
    "OtlpEndpoint": "http://localhost:4317",
    "MetricsExportIntervalMs": 10000,
    "EnablePrometheusEndpoint": true,
    "PrometheusPort": 9090
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/Nyx.Server-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}",
          "fileSizeLimitBytes": 10485760
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "Auth": {
    "PasswordSeed": 3721,
    "MaxFailedAttempts": 5,
    "AttemptDecaySeconds": 30,
    "TicketTtlSeconds": 90
  }
}
